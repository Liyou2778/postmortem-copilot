# ============================================================
# Postmortem Copilot 环境配置
# 用法：复制为 .env 后填写，不要提交到 git（.gitignore 已忽略）
#   copy .env.example .env
# ============================================================

# ---------- 模型（OpenAI 兼容接口）----------
# 常见国内厂商的 base_url（都要带 /v1）：
#   DeepSeek      https://api.deepseek.com/v1            model: deepseek-chat
#   阿里百炼       https://dashscope.aliyuncs.com/compatible-mode/v1   model: qwen-plus
#   智谱 GLM      https://open.bigmodel.cn/api/paas/v4    model: glm-4-plus
#   月之暗面       https://api.moonshot.cn/v1              model: moonshot-v1-8k
#   本地 Ollama   http://127.0.0.1:11434/v1               model: qwen2.5:7b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
# 成本记账单价；0 = 只统计 token，不算金额
LLM_COST_PER_1K_INPUT=0
LLM_COST_PER_1K_OUTPUT=0
LLM_CURRENCY=CNY

# ---------- 存储 ----------
CORE_DB_PATH=core.db
REDIS_URL=redis://127.0.0.1:6379/0
# 队列后端：sqlite（零依赖，默认）| redis（生产，需 REDIS_URL 可达）
QUEUE_BACKEND=sqlite

# ---------- Agent 预算 ----------
AGENT_MAX_RETRIES=2
AGENT_TOKEN_BUDGET=40000
AGENT_TOOL_BUDGET=25
STEP_DEADLINE_MS=180000
CONFLICT_MIN_CONFIDENCE=0.35
MAX_REPLANS=3

# ---------- 工具层 ----------
# local = 进程内 fixture（最快，适合单测）
# mcp   = 通过 stdio 连真实 MCP Server（推荐；Prometheus 走真实数据）
TOOL_BACKEND=mcp
TOOL_TIMEOUT_S=20
TOOL_RATE_LIMIT_PER_MIN=60

# 真实 Prometheus（ECS 上监听 127.0.0.1:9090；本机开发需 SSH 隧道）
PROMETHEUS_URL=http://127.0.0.1:9090
# Mock 演练上游。注意：ECS 上 node_exporter 占用 9100，devstack 请用 9101
DEVSTACK_URL=http://127.0.0.1:9100
# 真实日志：ECS 上由 Promtail 采集 journald 写入 Loki（127.0.0.1:3100）
LOKI_URL=http://127.0.0.1:3100
# 自建 CMDB + 发布/变更服务（M10.2，127.0.0.1:9200）
CMDB_URL=http://127.0.0.1:9200
DEPLOY_URL=http://127.0.0.1:9200
# M10.2 enterprise CMDB: v2 role tokens (required for /api/v2)
CMDB_TOKEN_VIEWER=
CMDB_TOKEN_EDITOR=
CMDB_TOKEN_APPROVER=
# Tenant that the v2 role tokens are scoped to. The optional platform token
# sees all tenants and is intended for platform_admin tooling only.
CMDB_TENANT=team-core
CMDB_TOKEN_PLATFORM=
# M10.6 local identity/tenant layer. Enable in production; bootstrap admin
# uses ADMIN_PASSWORD when no users exist.
AUTH_ENABLED=false
AUTH_SESSION_HOURS=12
RATE_LIMIT_PER_MIN=120
BOOTSTRAP_ADMIN_PASSWORD=
# Optional SSO via trusted reverse proxy (oauth2-proxy / OIDC gateway).
# The proxy must strip client copies of both headers and set them itself.
# AUTH_TRUSTED_HEADER=X-Auth-Request-User
# AUTH_TRUSTED_SECRET=change-me-long-random
# Standard OIDC authorization-code flow (Keycloak/Azure AD/Okta).
# Prefer putting these in /opt/copilot/.env.oidc (0600) instead of this file.
# OIDC_ISSUER=http://127.0.0.1:8080/realms/copilot
# OIDC_CLIENT_ID=postmortem-copilot
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/oidc/callback
# OIDC_STATE_SECRET=
# Service/CI script key created by scripts/provision_auth.py
COPILOT_API_KEY=
# OTLP/HTTP trace export (collector base URL; /v1/traces is appended).
# OTEL_EXPORTER_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=postmortem-copilot
# M10.3 Aliyun discovery (read-only; prefer ECS instance role)
ALIYUN_REGION=cn-hangzhou
CMDB_PROVIDER=aliyun
CMDB_CREDENTIAL_MODE=instance_role
CMDB_RAM_ROLE_NAME=copilot-cmdb-reader
CMDB_DEFAULT_SERVICE=ecs-copilot
CMDB_DEFAULT_HOST_ID=i-bp1gh7s0tybo7k602nzr
# 共享 MCP 网关：shared = 进程级复用；per_run = 回滚到旧行为
MCP_GATEWAY_MODE=shared
MCP_HEALTH_INTERVAL_S=30
# 允许被查询/写入服务目录的 host 白名单（逗号分隔）
# 生产只放 localhost/127.0.0.1 即可；要接外部 Loki 再把域名加进来
TOOL_URL_ALLOWLIST=localhost,127.0.0.1,prometheus,loki

# ---------- 服务目录 ----------
# 空库时自动种入 ecs-copilot（真实 Prometheus）和 order-service（devstack mock）
CATALOG_SEED=true
# 管理页 /admin/* 与目录写接口的 Basic Auth；留空 = 不鉴权（仅限本机演示）
ADMIN_USER=admin
ADMIN_PASSWORD=
